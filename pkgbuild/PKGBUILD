pkgname=cargohatch
pkgver=0.2.0
pkgrel=1
pkgdesc='A power-user file manager for Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/gsargent70/cargohatch'
license=('MIT')
depends=('qt6-base' 'qt6-wayland' 'qt6-multimedia')
optdepends=('poppler: previews of PDFs')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/cargohatch "$pkgdir/usr/bin/cargohatch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  local size
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/hicolor/${size}x${size}/apps/cargohatch.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/cargohatch.png"
  done
  install -Dm644 "$startdir/cargohatch.desktop" "$pkgdir/usr/share/applications/cargohatch.desktop"
}
